NODE_ENV=development
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Token que HighLevel enviará a /mcp. Debe ser distinto de ALMA_API_TOKEN.
MCP_BEARER_TOKEN=replace-with-at-least-32-random-characters

# La URL puede terminar en /api/ o no. El adaptador evita duplicar /api.
ALMA_BASE_URL=http://127.0.0.1:4010/api/
ALMA_API_TOKEN=replace-with-a-different-alma-token
ALMA_TIMEOUT_MS=8000
ALMA_READ_RETRIES=2
ALMA_TIMEZONE=America/Bogota

# Secreto HMAC independiente para firmar slots. Use al menos 32 caracteres aleatorios.
SLOT_TOKEN_SECRET=replace-with-at-least-32-random-characters-too
SLOT_TOKEN_TTL_SECONDS=300

DATABASE_URL=postgresql://alma_mcp:change-me@127.0.0.1:5432/alma_mcp
DATABASE_SSL_MODE=disable
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
MCP_SESSION_TTL_MS=1800000
MCP_MAX_SESSIONS=1000
JSON_BODY_LIMIT=256kb
SHUTDOWN_GRACE_MS=10000
